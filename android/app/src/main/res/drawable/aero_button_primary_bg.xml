<?xml version="1.0" encoding="utf-8"?>
<!-- Aero primary button: azure-to-sky gradient with state handling. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/aero_primary_disabled" />
            <corners android:radius="@dimen/aero_radius_button" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/aero_primary_pressed" />
            <corners android:radius="@dimen/aero_radius_button" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/aero_primary_hover"
                android:endColor="@color/aero_sky" />
            <stroke
                android:width="@dimen/aero_stroke_focus"
                android:color="@color/aero_focus" />
            <corners android:radius="@dimen/aero_radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/aero_primary"
                android:endColor="@color/aero_sky" />
            <corners android:radius="@dimen/aero_radius_button" />
        </shape>
    </item>
</selector>
