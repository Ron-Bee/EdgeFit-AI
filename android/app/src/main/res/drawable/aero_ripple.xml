<?xml version="1.0" encoding="utf-8"?>
<!-- Aero touch ripple (API 21+; minSdk 26, so always available). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/aero_glow_sky">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/aero_text_on_primary" />
            <corners android:radius="@dimen/aero_radius_button" />
        </shape>
    </item>
</ripple>
