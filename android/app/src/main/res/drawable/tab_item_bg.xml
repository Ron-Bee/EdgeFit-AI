<?xml version="1.0" encoding="utf-8"?>
<!-- Tab item background: subtle-blue pill when selected, transparent otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/edgefit_surface_border" />
            <corners android:radius="@dimen/edgefit_radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
