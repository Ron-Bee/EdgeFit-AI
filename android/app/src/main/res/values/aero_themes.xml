<?xml version="1.0" encoding="utf-8"?>
<!-- EdgeFit Aero design tokens: themes (EF-UX-AERO-01 Step 1).
     EF-ANDROID-AERO-BYOLLM-FINAL-02: Theme.EdgeFit.Aero is now the
     manifest application theme: all AlertDialogs inherit the dark
     Aero dialog theme; explicit light content was migrated alongside. -->
<resources>
    <style name="Theme.EdgeFit.Aero" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aero_page</item>
        <item name="android:colorBackground">@color/aero_page</item>
        <item name="android:colorPrimary">@color/aero_primary</item>
        <item name="android:colorAccent">@color/aero_sky</item>
        <item name="android:textColorPrimary">@color/aero_text_primary</item>
        <item name="android:textColorSecondary">@color/aero_text_secondary</item>
        <item name="android:textColorHint">@color/aero_text_disabled</item>
        <item name="android:buttonStyle">@style/Widget.Aero.Button.Primary</item>
        <item name="android:dialogTheme">@style/Theme.EdgeFit.Aero.Dialog</item>
    </style>

    <style name="Theme.EdgeFit.Aero.Dialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/aero_card_bg</item>
        <item name="android:colorBackground">@color/aero_card</item>
        <item name="android:colorPrimary">@color/aero_primary</item>
        <item name="android:colorAccent">@color/aero_sky</item>
        <item name="android:textColorPrimary">@color/aero_text_primary</item>
        <item name="android:textColorSecondary">@color/aero_text_secondary</item>
    </style>
</resources>
